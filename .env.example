# Set these in the process environment before running evidenceforge serve.
EVIDENCEFORGE_CORPUS=data/scifact/corpus.jsonl
EVIDENCEFORGE_API_KEYS=replace-with-a-local-key=public:reader
# Set both variables to enable the import endpoint.
EVIDENCEFORGE_IMPORT_ROOT=
EVIDENCEFORGE_ADMIN_TOKEN=
# Durable corpus and shared quotas on one host. Keep this file private.
EVIDENCEFORGE_STATE=data/state/corpus.sqlite3
EVIDENCEFORGE_REQUESTS_PER_MINUTE=120
# Optional CPU retrieval and local source selection.
EVIDENCEFORGE_DENSE=0
EVIDENCEFORGE_THREADS=6
EVIDENCEFORGE_MODEL_PATH=
EVIDENCEFORGE_LLM_PROTOCOL=chat
EVIDENCEFORGE_LLM_URL=http://127.0.0.1:18779/v1/chat/completions
EVIDENCEFORGE_LLM_MODEL=
EVIDENCEFORGE_LLM_TIMEOUT=90
EVIDENCEFORGE_LLM_CACHE_SECONDS=300
EVIDENCEFORGE_LLM_CACHE_VERSION=
