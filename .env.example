# Set these in the process environment before running evidenceforge serve.
EVIDENCEFORGE_CORPUS=data/scifact/corpus.jsonl
EVIDENCEFORGE_API_KEYS=replace-with-a-local-key=public:reader
# Set both variables to enable the import endpoint.
EVIDENCEFORGE_IMPORT_ROOT=
EVIDENCEFORGE_ADMIN_TOKEN=
# Optional CPU retrieval and local draft generation.
EVIDENCEFORGE_DENSE=0
EVIDENCEFORGE_THREADS=6
EVIDENCEFORGE_MODEL_PATH=
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=
